{
  "name": "snpm",
  "version": "0.5.0",
  "description": "A simple node package manager written in JavaScript",
  "repository": {
    "type": "git",
    "url": "https://github.com/Polymer-505/snpm"
  },
  "homepage": "https://github.com/Polymer-505/snpm#readme",
  "bugs": {
    "url": "https://github.com/Polymer-505/snpm/issues"
  },
  "main": "./src/bin/snpm-cli.js",
  "scripts": {
    "build": "pkg ./src/bin/snpm-cli.js --targets latest-linux-x64 --output ./build/snpm-linux",
    "build-arm64": "pkg ./src/bin/snpm-cli.js --targets latest-linux-arm64 --output ./build/snpm-linux-arm64"
  },
  "bin": {
    "snpm": "./src/bin/snpm-cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [],
  "author": "Polymer-505",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  },
  "dependencies": {
    "semver": "^7.8.6",
    "tar": "^7.5.23"
  }
}
